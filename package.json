{
  "name": "pomodoro-terminal",
  "version": "1.0.0",
  "description": "A terminal Pomodoro timer with tagged sessions and a dashboard",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "pomodoro",
    "timer",
    "terminal",
    "cli",
    "productivity"
  ],
  "author": "Abhitej Vennapu",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhitejVennapu/pomodoro-terminal.git"
  },
  "homepage": "https://github.com/AbhitejVennapu/pomodoro-terminal#readme",
  "bugs": {
    "url": "https://github.com/AbhitejVennapu/pomodoro-terminal/issues"
  },
  "type": "module",
  "bin": {
    "pomodoro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
